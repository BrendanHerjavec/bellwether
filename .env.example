# Copy to .env.local and fill in. .env* is gitignored.
#
# Nothing here is needed to run the parts that are finished: /play, /board and
# /lab all work against the in-memory store with no configuration at all. These
# are for step 3 onward, when trades move to the server.

# --- Supabase ---------------------------------------------------------------
# Project URL and the publishable (anon) key. Safe to expose to the browser:
# every table is RLS select-only and no mutating function is callable by anon.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. NEVER prefix this with NEXT_PUBLIC_ and never import it into a
# client component — it bypasses RLS entirely. It is the key the route handlers
# use to call execute_trade, settle_market and void_market, which are the only
# way anything in this app is allowed to change.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic --------------------------------------------------------------
# Server only. Used by the transcript resolver (step 5) and the market screening
# step (step 6), both called from route handlers.
ANTHROPIC_API_KEY=
